# Modele de configuration. install.sh genere config.env (non versionne) a partir de ce fichier.
# Utilisateur Windows (profil C:\Users\<nom>)
WIN_USER='utilisateur'
# Dossier du Bureau Windows, au format WSL (peut etre sous OneDrive)
DESKTOP_DIR='/mnt/c/Users/utilisateur/Desktop'
# Navigateur Windows (Chrome ou Edge), au format WSL
BROWSER_EXE='/mnt/c/Program Files/Google/Chrome/Application/chrome.exe'
# Profil dedie du navigateur (chemin Windows) : evite de toucher a votre session Chrome habituelle
BROWSER_PROFILE='C:\Users\utilisateur\AppData\Local\ClaudeQuotaProfile'
# Port local du serveur
PORT='8765'
# Taille de la fenetre (largeur,hauteur)
WINDOW_SIZE='300,230'
# Mode debug (0/1) : trace detaillee dans data/launch.log + data/server.log, et raccourci "Quota Claude (debug)".
# Peut etre force ponctuellement avec la variable d'environnement QUOTA_DEBUG=1.
DEBUG='0'
